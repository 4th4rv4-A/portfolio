# ── Portfolio Environment Configuration ─────────────────────
# Copy this file to `.env` and fill in the values.

# ── Flask Settings ───────────────────────────────────────────
# Set to "1" or "true" to enable debug mode (development only)
FLASK_DEBUG=0

# Secret key for Flask sessions (generate a random string for production)
SECRET_KEY=change-me-to-a-random-string

# Port to run the development server on
PORT=5000

# ── Contact Form Email Settings ──────────────────────────────
# These environment variables are required for the contact form
# to actually send emails. Without them, submissions are only
# logged to the console.
#
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords

MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_TO=recipient@example.com

# ── SMTP Configuration (optional — defaults to Gmail) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ── Site Configuration (set when domain is purchased) ────────
# SITE_URL=https://yourdomain.com
